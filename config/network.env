# microVM network. Its own /24, away from libvirt's default 192.168.122.0/24
# and Docker's 172.17.0.0/16.
# shellcheck shell=bash disable=SC2034

FC_BRIDGE=fcbr0
FC_NET_BASE=172.30.0          # first three octets of the /24
FC_SUBNET=172.30.0.0/24
FC_GATEWAY=172.30.0.1         # bridge address on the host
FC_PREFIX_LEN=24
FC_NETMASK=255.255.255.0
FC_GUEST_DNS=1.1.1.1

# Tap devices are named <prefix><last octet>, e.g. fctap2 for 172.30.0.2.
# Linux limits interface names to 15 characters.
FC_TAP_PREFIX=fctap

# nftables table that holds the NAT/forward rules. Owned entirely by this lab.
FC_NFT_TABLE=firecracker_lab

# Interface with the default route. Empty = auto-detect.
FC_UPLINK=
