# Pinned versions. Bump them here and nowhere else.
# shellcheck shell=bash disable=SC2034

# Firecracker + jailer release (https://github.com/firecracker-microvm/firecracker/releases)
FC_VERSION=v1.18.0

# Where the binaries are installed.
FC_INSTALL_PREFIX=/usr/local/bin

# Guest kernel, fetched from Firecracker's public CI bucket.
# The bucket uses rotating dated prefixes (firecracker-ci/YYYYMMDD-<sha>-0/).
# Leave FC_CI_PREFIX empty to use the newest one; set it to pin an exact build.
# kernel/fetch.sh writes what it actually fetched to build/vmlinux.version.
FC_CI_BUCKET=https://s3.amazonaws.com/spec.ccfc.min
FC_CI_PREFIX=
GUEST_KERNEL_SERIES=6.1

# Optional: build the guest kernel yourself (kernel/build.sh).
GUEST_KERNEL_BUILD_VERSION=6.1.188

# Default base image for the first labs.
BASE_IMAGE=alpine:3.22

# Defaults for a microVM.
VM_VCPUS=1
VM_MEM_MIB=256
